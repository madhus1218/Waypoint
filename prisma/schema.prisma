generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UploadStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
}

enum TripStatus {
  PROPOSED
  CONFIRMED
  ARCHIVED
}

model PhotoAsset {
  id      String @id @default(cuid())
  ownerId String

  uploadBatchId String
  uploadBatch   UploadBatch @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  filename String
  pathname String
  blobUrl  String
  mimeType String
  fileSize Int
  checksum String?

  latitude  Float?
  longitude Float?
  takenAt   DateTime?

  width       Int?
  height      Int?
  cameraMake  String?
  cameraModel String?

  hasGps       Boolean @default(false)
  hasTimestamp Boolean @default(false)
  warning      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, checksum])
  @@index([ownerId])
  @@index([uploadBatchId])
  @@index([tripId])
  @@index([takenAt])
}

model UploadBatch {
  id             String       @id @default(cuid())
  ownerId        String
  status         UploadStatus @default(UPLOADING)
  originalCount  Int          @default(0)
  processedCount Int          @default(0)
  warningCount   Int          @default(0)
  errorMessage   String?

  photos PhotoAsset[]
  trips  Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([createdAt])
}

model Trip {
  id      String  @id @default(cuid())
  ownerId String?

  uploadBatchId String?
  uploadBatch   UploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)

  title     String
  startDate DateTime
  endDate   DateTime
  city      String?
  country   String?
  notes     String?

  status     TripStatus @default(PROPOSED)
  confidence Float?
  centerLat  Float?
  centerLng  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photoPoints PhotoPoint[]
  photos      PhotoAsset[]

  @@index([ownerId])
  @@index([ownerId, startDate])
  @@index([ownerId, status])
  @@index([uploadBatchId])
}

model PhotoPoint {
  id String @id @default(cuid())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  filename  String?
  latitude  Float
  longitude Float
  takenAt   DateTime

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([takenAt])
}
